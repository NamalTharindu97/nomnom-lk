COMPOSE_PROJECT_NAME=nomnom-recruiter
NOMNOM_SECRET_ROOT=/etc/nomnom-recruiter/secrets

BACKEND_IMAGE=docker.io/namal97/nomnom-backend:0000000000000000000000000000000000000000
ADMIN_IMAGE=docker.io/namal97/nomnom-admin:0000000000000000000000000000000000000000
RECRUITER_DOMAIN=demo.nomnomlk.com

DATABASE_USER=nomnom_recruiter
DATABASE_NAME=nomnom_recruiter

# Existing approved images are read from the shared bucket. New writes use the
# recruiter prefix, though portfolio viewers cannot access upload routes.
R2_BUCKET=nomnom-images
R2_ENDPOINT=example.r2.cloudflarestorage.com
