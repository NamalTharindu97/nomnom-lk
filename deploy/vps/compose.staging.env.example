COMPOSE_PROJECT_NAME=nomnom-staging
NOMNOM_SECRET_ROOT=/etc/nomnom/secrets

# Application images use the full Git SHA produced by Deploy Staging.
BACKEND_IMAGE=docker.io/namal97/nomnom-backend:0000000000000000000000000000000000000000
ADMIN_IMAGE=docker.io/namal97/nomnom-admin:0000000000000000000000000000000000000000

# Database
DATABASE_USER=nomnom
DATABASE_NAME=nomnom

# R2 / Cloudflare
R2_BUCKET=nomnom-images
R2_ENDPOINT=9e4b33ed2e3cfb1fbbb837ada2399a6d.r2.cloudflarestorage.com

# SMTP
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USERNAME=mailer@example.test
SMTP_FROM="NomNom LK <noreply@example.test>"

# Admin
ADMIN_EMAIL=admin@nomnom.lk
